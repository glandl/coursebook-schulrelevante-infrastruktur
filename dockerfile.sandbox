# Sandbox dev container for the timemanager project — see sandbox.md for the decisions behind this file.
#
# Used via VS Code's Dev Containers extension, not run standalone in production.
# Project source is bind-mounted at runtime (only this repo's folder — see sandbox.md
# "Mount scope"), so this image intentionally does NOT COPY application source or run
# `npm install` for it — that happens against the live mounted source via a
# devcontainer.json postCreateCommand, since baking it in here would just be
# overwritten by the mount anyway.
#
# Base image note: the app's own dockerfiles (dockerfile.be/dockerfile.fe/dockerfile.combined)
# use node:lts-alpine for lean production runtimes. This is a dev-only image instead, so it
# uses the official Debian-based devcontainers base: better native-module/build compatibility,
# a pre-configured non-root user, and first-class support for the Dev Containers extension.
FROM mcr.microsoft.com/devcontainers/javascript-node:24-trixie

# --- Common tooling (would move to a shared base image once more projects are onboarded — see
#     sandbox.md "Base image strategy") ---

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
  && apt-get update && apt-get install -y gh \
  && rm -rf /var/lib/apt/lists/*

ENV NPM_CONFIG_PREFIX=/home/node/.npm-global
ENV PATH=/home/node/.npm-global/bin:$PATH

RUN mkdir -p /home/node/.npm-global \
    && chown -R node:node /home/node/.npm-global
# Claude Code + Codex CLIs, intentionally unpinned per sandbox.md "Version pinning":
# always installs latest at build time; rebuild with `docker build --no-cache` to refresh.
RUN npm install -g @anthropic-ai/claude-code @openai/codex

# --- Project-specific layer (this project's own runtime/tooling needs) ---

# Quasar CLI, needed for frontend dev commands (npx quasar dev/build), matching the
# global install already done in timemanager-quasar/dockerfile.fe.
# RUN npm install -g @quasar/cli

# Hugo extended, pinned to match .github/workflows/deploy.yml. Relearn 9.1.x requires
# Hugo >= 0.165.0, so the Debian-packaged hugo is not an option — install the release .deb.
ARG HUGO_VERSION=0.167.0
RUN arch="$(dpkg --print-architecture)" \
  && curl -fsSL -o /tmp/hugo.deb \
     "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-${arch}.deb" \
  && dpkg -i /tmp/hugo.deb \
  && rm -f /tmp/hugo.deb \
  && hugo version


# No Docker CLI, no Docker socket — deliberately absent per sandbox.md
# "Docker access from inside the sandbox": None.

# The javascript-node base image already creates and defaults to a non-root `node`
# user; kept explicit here per sandbox.md "Runtime user".
USER node

# --- Pi coding agent (mirrors the host setup so pi works identically inside the sandbox) ---

# Official managed installer (https://pi.dev/install.sh) — same install method used on the host,
# so it gets the same pinned-dependency managed layout and `pi update` semantics. Runs
# non-interactive in a build (no tty -> "continuing without confirmation"), executed as the
# `node` user so all state lands under /home/node/.pi, which devcontainer.json mounts as a
# named volume (same pattern as the claude-code/codex config mounts).
RUN curl -fsSL https://pi.dev/install.sh | sh

# The managed installer drops its launcher entrypoint at ~/.pi/agent/bin; make it resolvable
# from non-login shells (Docker exec PATH), same effect as the PATH entry the host installer
# leaves in the user's login shell.
ENV PATH=/home/node/.pi/agent/bin:$PATH

# Seed the host's Pi configuration so inside-the-sandbox pi resolves and defaults to the
# same provider/model: the pi-strata-provider package plus the "local" provider settings.
# NOT baked into the image: the API key. The provider config references apiKeyEnv=STRATA_API_KEY,
# supplied at runtime via the existing --env-file (.devcontainer/.env).
RUN sh <<'PISEED'
mkdir -p /home/node/.pi/agent
cat > /home/node/.pi/agent/settings.json <<'EOF'
{
  "packages": ["npm:pi-strata-provider"],
  "defaultProvider": "local",
  "defaultModel": "local/qwen3.8-flash-next-coder-iq1_m",
  "enabledModels": ["local/*", "openai-codex/*"],
  "modelThinkingLevels": {
    "local/strata-auto": "low"
  },
  "compaction": {
    "modelOverrides": {
      "local/strata-auto": { "reserveTokens": 20480, "keepRecentTokens": 16384 },
      "local/qwen3.8-flash-next-coder-iq1_m": { "reserveTokens": 20480, "keepRecentTokens": 16384 }
    }
  }
}
EOF
cat > /home/node/.pi/agent/strata-provider.json <<'EOF'
{
  "provider": "local",
  "baseUrl": "http://10.60.13.51:8080/v1",
  "apiKeyEnv": "STRATA_API_KEY"
}
EOF
PISEED

WORKDIR /workspaces/classroom-github-kanban

# Keeps the container alive for the Dev Containers extension to attach to;
# no sshd, no exposed port, per sandbox.md "Connection/editing".
CMD ["sleep", "infinity"]
